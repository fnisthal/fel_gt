<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_move_anular_wizard_form" model="ir.ui.view">
        <field name="name">account.move.anular.wizard.form</field>
        <field name="model">account.move.anular.wizard</field>
        <field name="arch" type="xml">
            <form string="Anular factura">
                <group>
                    <field name="move_id"/>
                    <field name="motivo_fel"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Anular" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
