<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="view_move_form">
        <field name="name">account.move.form.inherit.fel_gt</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_gt_extra.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_anular_factura_wizard" string="Anular" type="object" class="btn-secondary"
                        invisible="state != 'posted' or move_type not in ('out_invoice', 'out_refund', 'out_receipt') or estado_anulacion_fel == 'anulada'"/>
            </xpath>
            <xpath expr="//widget[@name='web_ribbon'][3]" position="attributes">
                <attribute name="invisible">payment_state != 'paid' or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or estado_anulacion_fel == 'anulada'</attribute>
            </xpath>
            <xpath expr="//widget[@name='web_ribbon'][7]" position="after">
                <widget name="web_ribbon" title="Anulada" bg_color="text-bg-danger" invisible="estado_anulacion_fel != 'anulada'"/>
            </xpath>
            <xpath expr="//page[@id='invoice_tab']" position="inside">
                <group>
                    <group>
                        <field name="firma_fel"/>
                        <field name="serie_fel"/>
                        <field name="numero_fel"/>
                        <field name="numero_acceso_fel" readonly="1"/>
                        <field name="factura_original_id"/>
                        <field name="fel_reversal_move_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="documento_xml_fel_name" invisible="1"/>
                        <field name="documento_xml_fel" readonly="1" filename="documento_xml_fel_name"/>
                        <field name="resultado_xml_fel_name" invisible="1"/>
                        <field name="resultado_xml_fel" readonly="1" filename="resultado_xml_fel_name"/>
                    </group>
                </group>
            </xpath>
            <field name="tipo_gasto" position="after">
                <field name="frase_exento_fel"/>
                <field name="motivo_fel"/>
                <field name="consignatario_fel" invisible="tipo_gasto != 'importacion'"/>
                <field name="exportador_fel" invisible="tipo_gasto != 'importacion'"/>
                <field name="incoterm_fel" invisible="tipo_gasto != 'importacion'"/>
                <field name="lugar_expedicion_fel" invisible="tipo_gasto != 'importacion'"/>
                <field name="otra_referencia_fel" invisible="tipo_gasto != 'importacion'"/>
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="view_invoice_tree">
        <field name="name">account.invoice.list.inherit.fel_gt</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="status_in_payment" position="after">
                <field name="estado_anulacion_fel" string="Anulación" widget="badge"
                       decoration-danger="estado_anulacion_fel"
                       invisible="not estado_anulacion_fel" optional="show"/>
            </field>
        </field>
    </record>
    
    <record model="ir.ui.view" id="view_account_journal_form">
        <field name="name">account.journal.form.inherit.fel_gt</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="l10n_gt_extra.view_account_journal_form"/>
        <field name="arch" type="xml">
            <page name="extra" position="inside">
                <group string="FEL GT">
                    <group>
                        <field name="generar_fel"/>
                        <field name="tipo_documento_fel"/>
                        <field name="error_en_historial_fel"/>
                    </group>
                    <group>
                        <field name="no_usar_descuento_fel"/>
                        <field name="enviar_lineas_en_cero_fel"/>
                    </group>
                    <group string="Descripción de línea en FEL">
                        <field name="incluir_referencia_producto_fel"/>
                        <field name="incluir_nombre_producto_fel"/>
                        <field name="incluir_descripcion_adicional_fel"/>
                    </group>
                </group>
            </page>
        </field>
    </record>
    
    <record model="ir.ui.view" id="view_tax_form">
        <field name="name">account.tax.form.inherit.fel_gt</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Extra">
                    <group string="FEL">
                        <group>
                            <field name="tipo_impuesto_fel"/>
                            <field name="codigo_unidad_gravable_fel"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
        
</odoo>
